+/* Android-only, A7xx laboratory probe. This prints the actual device IDs
+ * before the A740/Eden counter gate and bypasses Mesa logging controls. Bounded
+ * to one line per process every 10 s, shared by both queue submit callbacks.
+ * A7xx is the diagnostic observation scope; readback counts stay A740-gated.
+ */
+static void
+amaral_readback_queue_heartbeat(struct tu_device *device, const char *path)
+{
+#if DETECT_OS_ANDROID
+   if (device->physical_device->info->chip != 7)
+      return;
+   const auto &lab_id = device->physical_device->dev_id;
+   const auto &app = device->instance->vk.app_info;
+   const uint64_t entries = amaral_rb_submit_entries.fetch_add(1, std::memory_order_relaxed) + 1;
+   const uint64_t now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+   if (!amaral_readback_report_due(now_ms))
+      return;
+   const auto &rb = amaral_rb_totals;
+   __android_log_print(ANDROID_LOG_INFO, "AmaralRB",
+      "AMARAL_RB_V3 path=%s gpu=%u chip=%llx app_match=%u engine_match=%u "
+      "scope=%u queue_entries=%llu regions=%llu layers=%llu row_layers=%llu "
+      "runs=%llu requested_bytes=%llu r3d_regions=%llu last_vk_format=%u",
+      path, lab_id.gpu_id, (unsigned long long)lab_id.chip_id,
+      unsigned(amaral_readback_app(app.app_name)),
+      unsigned(amaral_readback_app(app.engine_name)),
+      unsigned(amaral_readback_scope(lab_id.gpu_id, lab_id.chip_id,
+                                     app.app_name, app.engine_name)),
+      (unsigned long long)entries,
+      (unsigned long long)rb.regions.load(std::memory_order_relaxed),
+      (unsigned long long)rb.layers.load(std::memory_order_relaxed),
+      (unsigned long long)rb.row_layers.load(std::memory_order_relaxed),
+      (unsigned long long)rb.runs.load(std::memory_order_relaxed),
+      (unsigned long long)rb.requested_bytes.load(std::memory_order_relaxed),
+      (unsigned long long)rb.r3d_regions.load(std::memory_order_relaxed),
+      rb.last_vk_format.load(std::memory_order_relaxed));
+#else
+   (void)device;
+   (void)path;
+#endif
+}
+
 static VkResult
 queue_submit_sparse(struct vk_queue *_queue, struct vk_queue_submit *vk_submit)
 {
    struct tu_queue *queue = list_entry(_queue, struct tu_queue, vk);
    struct tu_device *device = queue->device;
