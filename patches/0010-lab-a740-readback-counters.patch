+++ b/src/freedreno/vulkan/tu_amaral_readback_lab.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef TU_AMARAL_READBACK_LAB_H
+#define TU_AMARAL_READBACK_LAB_H
+#include <atomic>
+#include <cstdint>
+#include <string_view>
+
+static inline bool
+amaral_readback_gpu(uint32_t gpu, uint64_t chip)
+{
+   return (gpu == 740 && chip == 0) ||
+      ((chip == 0x43050a01ULL || chip == 0xffff43050a01ULL) && (gpu == 0 || gpu == 740));
+}
+static inline bool amaral_readback_app(const char *name)
+{
+   return name && std::string_view(name) == "yuzu Emulator";
+}
+static inline bool
+amaral_readback_scope(uint32_t gpu, uint64_t chip, const char *app, const char *engine)
+{
+   return amaral_readback_gpu(gpu, chip) && amaral_readback_app(app) &&
+          amaral_readback_app(engine);
+}
+
+/* Process-wide diagnostic counts for eligible devices. Independent relaxed
+ * loads are not an atomic snapshot. Counts describe recording, not execution.
+ * No reset: subtract successive snapshots; never attribute totals to one frame.
+ */
+struct amaral_readback_totals {
+   std::atomic<uint64_t> regions{0}, layers{0}, row_layers{0}, runs{0};
+   std::atomic<uint64_t> requested_bytes{0}, r3d_regions{0};
+   std::atomic<uint32_t> last_vk_format{0};
+   void add(uint32_t format, uint64_t layer_count, uint64_t row_count,
+            uint64_t run_count, uint64_t bytes, bool r3d)
+   {
+      layers.fetch_add(layer_count, std::memory_order_relaxed);
+      row_layers.fetch_add(row_count, std::memory_order_relaxed);
+      runs.fetch_add(run_count, std::memory_order_relaxed);
+      requested_bytes.fetch_add(bytes, std::memory_order_relaxed);
+      r3d_regions.fetch_add(r3d, std::memory_order_relaxed);
+      last_vk_format.store(format, std::memory_order_relaxed);
+      regions.fetch_add(1, std::memory_order_relaxed);
+   }
+};
+static_assert(std::atomic<uint64_t>::is_always_lock_free);
+/* Inline variables deliberately share state across clear/blit and queue TUs. */
+inline amaral_readback_totals amaral_rb_totals;
+inline std::atomic<uint64_t> amaral_rb_submit_entries{0};
+inline std::atomic<uint64_t> amaral_rb_last_report_ms{0};
+static inline bool amaral_readback_report_due(uint64_t now_ms)
+{
+   auto previous = amaral_rb_last_report_ms.load(std::memory_order_relaxed);
+   if (now_ms == 0 || (previous && (now_ms < previous || now_ms - previous < 10000)))
+      return false;
+   return amaral_rb_last_report_ms.compare_exchange_strong(
+      previous, now_ms, std::memory_order_relaxed);
+}
+#endif
