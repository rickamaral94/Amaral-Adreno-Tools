--- /dev/null
+++ b/src/freedreno/vulkan/tu_amaral_readback_lab.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef TU_AMARAL_READBACK_LAB_H
+#define TU_AMARAL_READBACK_LAB_H
+#include <cstdint>
+#include <string_view>
+
+static inline bool
+amaral_readback_scope(uint32_t gpu, uint64_t chip, const char *app, const char *engine)
+{
+   const bool a740 = (gpu == 740 && chip == 0) ||
+      ((chip == 0x43050a01ULL || chip == 0xffff43050a01ULL) && (gpu == 0 || gpu == 740));
+   return a740 && app && engine && std::string_view(app) == "yuzu Emulator" &&
+          std::string_view(engine) == "yuzu Emulator";
+}
+
+/* Command recording counts, never GPU completion/timing or bytes on the bus.
+ * One thread-local batch per recording thread. No locks, allocation or waits.
+ */
+struct amaral_readback_batch {
+   uint64_t regions = 0, layers = 0, row_layers = 0, runs = 0;
+   uint64_t requested_bytes = 0, r3d_regions = 0, other_formats = 0;
+   uint32_t formats[256] = {};
+   uint32_t dominant_format = 0;
+
+   bool add(uint32_t format, uint64_t layer_count, uint64_t row_count,
+            uint64_t run_count, uint64_t bytes, bool r3d)
+   {
+      ++regions;
+      layers += layer_count;
+      row_layers += row_count;
+      runs += run_count;
+      requested_bytes += bytes;
+      r3d_regions += r3d;
+      if (format < 256) {
+         ++formats[format];
+         if (formats[format] > formats[dominant_format]) dominant_format = format;
+      } else {
+         ++other_formats;
+      }
+      return regions == 512;
+   }
+};
+#endif
