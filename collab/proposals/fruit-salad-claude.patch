+def fold(text):
+    """Minúsculas sem acento: limão, Limao e LIMÃO viram limao."""
+    import unicodedata
+    return "".join(c for c in unicodedata.normalize("NFKD", text.lower()) if not unicodedata.combining(c))
+
+
+def fruit_table():
+    return json.loads(FRUITS.read_text(encoding="utf-8"))["fruits"]
+
+
+def detect_fruits(text, table=None):
+    """Frutas no começo da primeira linha, em ordem de execução.
+
+    Lê palavra a palavra e para no primeiro termo que não é fruta nem conector
+    ("e", "+", ","), para que "Morango, segue o zip" acione só morango e
+    "manga" no meio de uma frase não acione nada.
+    """
+    table = table or fruit_table()
+    lookup = {}
+    for key, info in table.items():
+        for word in [key, *info.get("aliases", [])]:
+            lookup[fold(word)] = key
+        if info.get("emoji"):
+            lookup[info["emoji"]] = key
+    first = text.strip().splitlines()[0] if text.strip() else ""
+    found = []
+    for raw in re.split(r"[\s,;:+/!.]+", first):
+        token = fold(raw.strip("*_`'\"()[]").replace("\ufe0f", ""))
+        if not token or token in {"e", "and", "&", "-"}:
+            continue
+        key = lookup.get(token)
+        if not key:
+            break
+        if key not in found:
+            found.append(key)
+    return sorted(found, key=lambda k: table[k].get("order", 99))
+
+
+def cmd_fruit(a):
+    table = fruit_table()
+    if a.detect is not None:
+        keys = detect_fruits(a.detect, table)
+        if not keys:
+            print("nenhuma fruta na primeira linha: siga a mensagem normalmente.")
+            return
+    elif a.names:
+        keys, unknown = [], []
+        for name in a.names:
+            key = next((k for k, v in table.items() if fold(name) in {fold(k), *map(fold, v.get("aliases", []))}), None)
+            (keys if key else unknown).append(key or name)
+        if unknown:
+            sys.exit(f"fruta desconhecida: {', '.join(unknown)}; veja collab.py fruit")
+        keys = sorted(dict.fromkeys(keys), key=lambda k: table[k].get("order", 99))
+    else:
+        for key, info in sorted(table.items(), key=lambda kv: kv[1].get("order", 99)):
+            print(f"{info.get('emoji', '')} {key:9} {info['name']}: {info['when']}")
+        return
+    for key in keys:
+        info = table[key]
+        print(f"\n{info.get('emoji', '')} {key}: {info['name']}")
+        for i, step in enumerate(info["steps"], 1):
+            print(f"  {i}. {step}")
+    print("\nNenhuma fruta autoriza merge, publicação ou release.")
+
+
+def render(text, values):
+    for key, value in values.items():
+        text = text.replace("{{" + key + "}}", value)
+    return text
