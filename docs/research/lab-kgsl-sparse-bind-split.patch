+/* KGSL keeps one interval per bound range, and an UNBIND removes every
+ * interval it overlaps in full: kgsl_memdesc_remove_range() unmaps the whole
+ * interval, not just the part that was asked for. Unbinding one sparse block
+ * that lies inside a larger earlier bind would therefore also unmap its
+ * neighbours, which then read zeros or fault. Bind in pieces that never cross
+ * a 64 KiB sparse block, the smallest unit the application can unbind, so
+ * that every later unbind removes exactly what it names.
+ */
+#define KGSL_SPARSE_BIND_BLOCK 65536ull
+
+static void
+kgsl_submit_add_bind(struct tu_device *device,
+                     void *_submit,
+                     struct tu_sparse_vma *vma, uint64_t vma_offset,
+                     struct tu_bo *bo, uint64_t bo_offset,
+                     uint64_t size)
+{
+   if (!bo) {
+      kgsl_submit_add_bind_range(device, _submit, vma, vma_offset, NULL, 0,
+                                 size);
+      return;
+   }
+
+   while (size) {
+      uint64_t block_end =
+         (vma_offset & ~(KGSL_SPARSE_BIND_BLOCK - 1)) + KGSL_SPARSE_BIND_BLOCK;
+      uint64_t len = MIN2(size, block_end - vma_offset);
+
+      kgsl_submit_add_bind_range(device, _submit, vma, vma_offset, bo,
+                                 bo_offset, len);
+      vma_offset += len;
+      bo_offset += len;
+      size -= len;
+   }
+}
