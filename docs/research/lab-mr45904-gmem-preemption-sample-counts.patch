From 306739e220c5d20eff8b3ad4872f18d21bdcfe8d Mon Sep 17 00:00:00 2001
From: Dhruv Mark Collins <mark@igalia.com>
Date: Mon, 2 Nov 2026 21:40:15 +0000
Subject: [PATCH 3/3] tu: Count occlusion queries outside of render passes
 around each tile

An occlusion query begun outside of a render pass emitted one ZPASS_DONE
pair around everything it contained. GMEM rendering can be preempted
between tiles, and the sample count isn't kept across the context
switch, so that pair could count too few samples, or end below its
start.

Count such a query when the render passes it contains are rendered
instead, with a pair around the draws of each tile, or of a SYSMEM
render pass. vkCmdBeginQuery then emits nothing, and vkCmdEndQuery only
marks the query available.

A secondary command buffer recorded with occlusionQueryEnable counts
the render passes it renders itself into a slot of its own, which the
command buffer executing it zeroes before and adds to its count after.

Signed-off-by: Dhruv Mark Collins <mark@igalia.com>
Assisted-by: LLM
---
 src/freedreno/vulkan/tu_cmd_buffer.cc |  15 ++
 src/freedreno/vulkan/tu_cmd_buffer.h  |   9 ++
 src/freedreno/vulkan/tu_query_pool.cc | 220 ++++++++++++++++++++------
 src/freedreno/vulkan/tu_query_pool.h  |  29 ++++
 4 files changed, 227 insertions(+), 46 deletions(-)

diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index 8e82c287ed7..c1252bbb8d0 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -25,6 +25,7 @@
 #include "tu_image.h"
 #include "tu_knl.h"
 #include "tu_perfetto.h"
+#include "tu_query_pool.h"
 #include "tu_scratch_ram.h"
 #include "tu_subsampled_image.h"
 #include "tu_tile_config.h"
@@ -3806,7 +3807,9 @@ tu6_render_tile(struct tu_cmd_buffer *cmd, struct tu_cs *cs,
    if (cmd->state.prim_generated_query_running_before_rp)
       tu_emit_event_write<CHIP>(cmd, cs, FD_STOP_PRIMITIVE_CTRS);
 
+   tu_occlusion_query_draws_begin<CHIP>(cmd, cs);
    tu_cs_emit_call(cs, &cmd->draw_cs);
+   tu_occlusion_query_draws_end<CHIP>(cmd, cs);
 
    if (cmd->state.prim_generated_query_running_before_rp)
       tu_emit_event_write<CHIP>(cmd, cs, FD_START_PRIMITIVE_CTRS);
@@ -4169,7 +4172,9 @@ tu_cmd_render_sysmem(struct tu_cmd_buffer *cmd,
 
    trace_start_draw_ib_sysmem(&cmd->trace, &cmd->cs, cmd);
 
+   tu_occlusion_query_draws_begin<CHIP>(cmd, &cmd->cs);
    tu_cs_emit_call(&cmd->cs, &cmd->draw_cs);
+   tu_occlusion_query_draws_end<CHIP>(cmd, &cmd->cs);
 
    trace_end_draw_ib_sysmem(&cmd->trace, &cmd->cs);
 
@@ -4194,11 +4199,15 @@ tu_cmd_render(struct tu_cmd_buffer *cmd_buffer,
 
    tu_autotune::rp_key_opt rp_key = cmd_buffer->device->autotune->emit_preempt_latency_tracking_rp_hash(cmd_buffer);
 
+   tu_occlusion_query_render_begin<CHIP>(cmd_buffer);
+
    tu_autotune::rp_ctx_t rp_ctx = NULL;
    if (use_sysmem_rendering(cmd_buffer, &rp_ctx, rp_key))
       tu_cmd_render_sysmem<CHIP>(cmd_buffer, rp_ctx);
    else
       tu_cmd_render_tiles<CHIP>(cmd_buffer, rp_ctx, fdm_offsets);
+
+   tu_occlusion_query_render_end<CHIP>(cmd_buffer);
 }
 
 static void tu_reset_render_pass(struct tu_cmd_buffer *cmd_buffer)
@@ -4553,6 +4562,8 @@ tu_BeginCommandBuffer(VkCommandBuffer commandBuffer,
 
       cmd_buffer->inherited_pipeline_statistics =
          pBeginInfo->pInheritanceInfo->pipelineStatistics;
+      cmd_buffer->inherited_occlusion_query =
+         pBeginInfo->pInheritanceInfo->occlusionQueryEnable;
 
       cmd_buffer->state.occlusion_query_may_be_running =
          pBeginInfo->pInheritanceInfo->occlusionQueryEnable;
@@ -6615,7 +6626,9 @@ tu_CmdExecuteCommands(VkCommandBuffer commandBuffer,
          case SR_NONE:
             assert(tu_cs_is_empty(&secondary->draw_cs));
             assert(tu_cs_is_empty(&secondary->draw_epilogue_cs));
+            TU_CALLX(cmd->device, tu_occlusion_query_execute_begin)(cmd, secondary);
             tu_cs_add_entries(&cmd->cs, &secondary->cs);
+            TU_CALLX(cmd->device, tu_occlusion_query_execute_end)(cmd, secondary);
             TU_CALLX(cmd->device, tu_clone_trace)(cmd, &cmd->cs, &cmd->trace, &secondary->trace);
             break;
 
@@ -6686,7 +6699,9 @@ tu_CmdExecuteCommands(VkCommandBuffer commandBuffer,
                tu_reset_render_pass(cmd);
             }
 
+            TU_CALLX(cmd->device, tu_occlusion_query_execute_begin)(cmd, secondary);
             tu_cs_add_entries(&cmd->cs, &secondary->cs);
+            TU_CALLX(cmd->device, tu_occlusion_query_execute_end)(cmd, secondary);
 
             if (secondary->state.suspend_resume == SR_IN_CHAIN_AFTER_PRE_CHAIN ||
                 secondary->state.suspend_resume == SR_IN_CHAIN) {
diff --git a/src/freedreno/vulkan/tu_cmd_buffer.h b/src/freedreno/vulkan/tu_cmd_buffer.h
index 48577e76e88..f925bb60b58 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.h
+++ b/src/freedreno/vulkan/tu_cmd_buffer.h
@@ -654,6 +654,14 @@ struct tu_cmd_state
 
    bool occlusion_query_may_be_running;
 
+   /* The occlusion query begun outside of a render pass, if any, and how its
+    * samples are counted.
+    */
+   struct tu_query_pool *outside_occlusion_query_pool;
+   uint32_t outside_occlusion_query;
+   uint64_t own_occlusion_query_iova;
+   uint64_t rendering_occlusion_query_iova;
+
    bool trace_draws_enabled;
    enum tu_pipeline_type trace_draws_pipeline_type;
 
@@ -730,6 +738,7 @@ struct tu_cmd_buffer
    VkCommandBufferUsageFlags usage_flags;
 
    VkQueryPipelineStatisticFlags inherited_pipeline_statistics;
+   bool inherited_occlusion_query;
 
    struct tu_cmd_state state;
    uint32_t queue_family_index;
diff --git a/src/freedreno/vulkan/tu_query_pool.cc b/src/freedreno/vulkan/tu_query_pool.cc
index 99ae93fe11c..0172f16ac97 100644
--- a/src/freedreno/vulkan/tu_query_pool.cc
+++ b/src/freedreno/vulkan/tu_query_pool.cc
@@ -1087,7 +1087,9 @@ tu_ResetQueryPool(VkDevice device,
 }
 TU_GENX(tu_ResetQueryPool);
 
-/* The begin, result and end of an occlusion query slot, from begin_iova on. */
+/* The begin, result and end of an occlusion query slot, from begin_iova on,
+ * which is also the layout of a secondary command buffer's own slot.
+ */
 static_assert(offsetof(struct occlusion_query_slot, result) ==
               offsetof(struct occlusion_query_slot, begin) + 8);
 static_assert(offsetof(struct occlusion_query_slot, end) ==
@@ -1095,7 +1097,9 @@ static_assert(offsetof(struct occlusion_query_slot, end) ==
 
 /* Resume counting samples into the slot at begin_iova: the begin half of a
  * ZPASS_DONE event pair, which emit_occlusion_query_pause() closes and adds to
- * the slot's result.
+ * the slot's result. The pair is emitted around draws that run on one tile at
+ * a time (draw_cs, or each tile's call of it), so each tile's samples are
+ * added on their own.
  */
 template <chip CHIP>
 static void
@@ -1122,26 +1126,12 @@ emit_occlusion_query_resume(struct tu_cmd_buffer *cmdbuf,
                                        .write_sample_count = true).value);
       tu_cs_emit_qw(cs, begin_iova);
 
-      /* ZPASS_DONE events should come in begin-end pairs. When emitting and
-       * occlusion query outside of a renderpass, we emit a fake end event that
-       * closes the previous one since the autotuner's ZPASS_DONE use could end
-       * up causing problems. This events writes into the end field of the query
-       * slot, but it will be overwritten by events in
-       * emit_occlusion_query_pause() with the proper value.
-       * When inside a renderpass, the corresponding ZPASS_DONE event will be
-       * emitted in emit_occlusion_query_pause(). We note the use of ZPASS_DONE
-       * on the state object, enabling autotuner to optimize its own events.
+      /* ZPASS_DONE events should come in begin-end pairs. The corresponding
+       * ZPASS_DONE event will be emitted in emit_occlusion_query_pause(). We
+       * note the use of ZPASS_DONE on the state object, enabling autotuner to
+       * optimize its own events.
        */
-      if (!cmdbuf->state.pass) {
-         tu_cs_emit_pkt7(cs, CP_EVENT_WRITE7, 3);
-         tu_cs_emit(cs, CP_EVENT_WRITE7_0(.event = ZPASS_DONE,
-                                          .write_sample_count = true,
-                                          .sample_count_end_offset = true,
-                                          .write_accum_sample_count_diff = true).value);
-         tu_cs_emit_qw(cs, begin_iova);
-      } else {
