From bdc814940af782df7f5aa601ad4078125ebb0e8c Mon Sep 17 00:00:00 2001
From: Dhruv Mark Collins <mark@igalia.com>
Date: Mon, 26 Oct 2026 20:55:05 +0000
Subject: [PATCH 1/3] tu/autotune: Count samples passed per tile in GMEM

GMEM rendering can be preempted between tiles, and the sample count
isn't kept across the context switch, so a ZPASS_DONE pair around a
whole GMEM render pass can count too few samples, or end below its
start.

Where the events can accumulate their difference, emit a pair around
each tile instead and read the sum, which is zeroed on the GPU at the
start of the render pass since a command buffer can be submitted more
than once. SYSMEM render passes, and GPUs whose events can't
accumulate, keep one pair.

Signed-off-by: Dhruv Mark Collins <mark@igalia.com>
Assisted-by: LLM
---
 src/freedreno/vulkan/tu_autotune.cc | 39 ++++++++++++++++++++++++++---
 1 file changed, 36 insertions(+), 3 deletions(-)

diff --git a/src/freedreno/vulkan/tu_autotune.cc b/src/freedreno/vulkan/tu_autotune.cc
index 2e3dd4d3d72..21533c94e8e 100644
--- a/src/freedreno/vulkan/tu_autotune.cc
+++ b/src/freedreno/vulkan/tu_autotune.cc
@@ -423,6 +423,8 @@ tu_autotune::get_cs_for_fence(uint32_t fence)
 struct PACKED tu_autotune::rp_gpu_data {
    /* HW requires the sample start/stop locations to be 128b aligned. */
    alignas(16) uint64_t samples_start;
+   /* The sum of the samples passed in each tile, see samples_per_tile(). */
+   uint64_t samples_accum;
    alignas(16) uint64_t samples_end;
    uint64_t ts_start;
    uint64_t ts_end;
@@ -519,6 +521,7 @@ struct tu_autotune::rp_entry {
 
    static_assert(alignof(rp_gpu_data) == 16);
    static_assert(offsetof(rp_gpu_data, samples_start) == 0);
+   static_assert(offsetof(rp_gpu_data, samples_accum) == 8);
    static_assert(offsetof(rp_gpu_data, samples_end) == 16);
    static_assert(sizeof(rp_gpu_data) % alignof(tile_gpu_data) == 0);
 
@@ -581,10 +584,21 @@ struct tu_autotune::rp_entry {
 
    /** Samples-Passed Metric **/
 
+   /* A GMEM pass can be preempted between tiles, and the sample counter doesn't carry its count over the switch, so
+    * a pair of events around the whole pass can count too few samples or end below its start. Where the events can
+    * accumulate, each tile counts its own samples instead.
+    */
+   bool samples_per_tile()
+   {
+      return !sysmem && device->physical_device->info->props.has_event_write_sample_count;
+   }
+
    uint64_t get_samples_passed()
    {
       assert(config.test(metric_flag::SAMPLES));
       rp_gpu_data &gpu = get_gpu_data();
+      if (samples_per_tile())
+         return gpu.samples_accum;
       return gpu.samples_end - gpu.samples_start;
    }
 
@@ -641,6 +655,14 @@ struct tu_autotune::rp_entry {
       }
    }
 
+   /* A command buffer can run more than once, so the sum starts from zero on the GPU. */
+   void emit_metric_samples_reset(struct tu_cs *cs, uint64_t accum_iova)
+   {
+      tu_cs_emit_pkt7(cs, CP_MEM_WRITE, 4);
+      tu_cs_emit_qw(cs, accum_iova);
+      tu_cs_emit_qw(cs, 0);
+   }
+
    /** RP/Tile Timestamp Metric **/
 
    uint64_t get_rp_duration()
@@ -692,8 +714,12 @@ struct tu_autotune::rp_entry {
    {
       assert(map && bo.iova);
       uint64_t bo_iova = bo.iova;
-      if (config.test(metric_flag::SAMPLES))
-         emit_metric_samples_start(cmd, cs, bo_iova + offsetof(rp_gpu_data, samples_start));
+      if (config.test(metric_flag::SAMPLES)) {
+         if (samples_per_tile())
+            emit_metric_samples_reset(cs, bo_iova + offsetof(rp_gpu_data, samples_accum));
+         else
+            emit_metric_samples_start(cmd, cs, bo_iova + offsetof(rp_gpu_data, samples_start));
+      }
 
       if (config.test(metric_flag::TS))
          emit_metric_timestamp(cs, bo_iova + offsetof(rp_gpu_data, ts_start));
@@ -703,7 +729,7 @@ struct tu_autotune::rp_entry {
    {
       assert(map && bo.iova);
       uint64_t bo_iova = bo.iova;
-      if (config.test(metric_flag::SAMPLES))
+      if (config.test(metric_flag::SAMPLES) && !samples_per_tile())
          emit_metric_samples_end(cmd, cs, bo_iova + offsetof(rp_gpu_data, samples_start),
                                  bo_iova + offsetof(rp_gpu_data, samples_end));
 
@@ -716,6 +742,9 @@ struct tu_autotune::rp_entry {
       assert(map && bo.iova);
       assert(!sysmem);
       assert(tile_index < tile_count);
+      if (config.test(metric_flag::SAMPLES) && samples_per_tile())
+         emit_metric_samples_start(cmd, cs, bo.iova + offsetof(rp_gpu_data, samples_start));
+
       if (config.test(metric_flag::TS_TILE))
          emit_metric_timestamp(cs, bo.iova + tile_gpu_data::offset(tile_index) + offsetof(tile_gpu_data, ts_start));
    }
@@ -725,6 +754,10 @@ struct tu_autotune::rp_entry {
       assert(map && bo.iova);
       assert(!sysmem);
       assert(tile_index < tile_count);
+      if (config.test(metric_flag::SAMPLES) && samples_per_tile())
+         emit_metric_samples_end(cmd, cs, bo.iova + offsetof(rp_gpu_data, samples_start),
+                                 bo.iova + offsetof(rp_gpu_data, samples_end));
+
       if (config.test(metric_flag::TS_TILE))
          emit_metric_timestamp(cs, bo.iova + tile_gpu_data::offset(tile_index) + offsetof(tile_gpu_data, ts_end));
    }
-- 
