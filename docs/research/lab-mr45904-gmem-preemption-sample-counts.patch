From ffa094b79398fae92be612d5366c200fb864b2b4 Mon Sep 17 00:00:00 2001
From: Dhruv Mark Collins <mark@igalia.com>
Date: Mon, 2 Nov 2026 21:37:44 +0000
Subject: [PATCH 2/3] tu: Split the sample counting pair out of occlusion query
 begin and end

Move emitting the ZPASS_DONE pair into functions that take the command
stream and the query slot, so that the next commit can emit them where
render passes are rendered.

No functional change.

Signed-off-by: Dhruv Mark Collins <mark@igalia.com>
Assisted-by: LLM
---
 src/freedreno/vulkan/tu_query_pool.cc | 117 ++++++++++++++++----------
 1 file changed, 74 insertions(+), 43 deletions(-)

diff --git a/src/freedreno/vulkan/tu_query_pool.cc b/src/freedreno/vulkan/tu_query_pool.cc
index f5a27c80a48..99ae93fe11c 100644
--- a/src/freedreno/vulkan/tu_query_pool.cc
+++ b/src/freedreno/vulkan/tu_query_pool.cc
@@ -1087,31 +1087,22 @@ tu_ResetQueryPool(VkDevice device,
 }
 TU_GENX(tu_ResetQueryPool);
 
+/* The begin, result and end of an occlusion query slot, from begin_iova on. */
+static_assert(offsetof(struct occlusion_query_slot, result) ==
+              offsetof(struct occlusion_query_slot, begin) + 8);
+static_assert(offsetof(struct occlusion_query_slot, end) ==
+              offsetof(struct occlusion_query_slot, begin) + 16);
+
+/* Resume counting samples into the slot at begin_iova: the begin half of a
+ * ZPASS_DONE event pair, which emit_occlusion_query_pause() closes and adds to
+ * the slot's result.
+ */
 template <chip CHIP>
 static void
-emit_begin_occlusion_query(struct tu_cmd_buffer *cmdbuf,
-                           struct tu_query_pool *pool,
-                           uint32_t query)
+emit_occlusion_query_resume(struct tu_cmd_buffer *cmdbuf,
+                            struct tu_cs *cs,
+                            uint64_t begin_iova)
 {
-   /* From the Vulkan 1.1.130 spec:
-    *
-    *    A query must begin and end inside the same subpass of a render pass
-    *    instance, or must both begin and end outside of a render pass
-    *    instance.
-    *
-    * Unlike on an immediate-mode renderer, Turnip renders all tiles on
-    * vkCmdEndRenderPass, not individually on each vkCmdDraw*. As such, if a
-    * query begins/ends inside the same subpass of a render pass, we need to
-    * record the packets on the secondary draw command stream. cmdbuf->draw_cs
-    * is then run on every tile during render, so we just need to accumulate
-    * sample counts in slot->result to compute the query result.
-    */
-   struct tu_cs *cs = cmdbuf->state.pass ? &cmdbuf->draw_cs : &cmdbuf->cs;
-   cmdbuf->state.occlusion_query_may_be_running = true;
-   cmdbuf->state.dirty |= TU_CMD_DIRTY_DISABLE_FS | TU_CMD_DIRTY_LRZ;
-
-   uint64_t begin_iova = occlusion_query_iova(pool, query, begin);
-
    tu_cs_emit_regs(cs,
                    A6XX_RB_SAMPLE_COUNTER_CNTL(.copy = true));
 
@@ -1135,11 +1126,11 @@ emit_begin_occlusion_query(struct tu_cmd_buffer *cmdbuf,
        * occlusion query outside of a renderpass, we emit a fake end event that
        * closes the previous one since the autotuner's ZPASS_DONE use could end
        * up causing problems. This events writes into the end field of the query
-       * slot, but it will be overwritten by events in emit_end_occlusion_query
-       * with the proper value.
+       * slot, but it will be overwritten by events in
+       * emit_occlusion_query_pause() with the proper value.
        * When inside a renderpass, the corresponding ZPASS_DONE event will be
-       * emitted in emit_end_occlusion_query. We note the use of ZPASS_DONE on
-       * the state object, enabling autotuner to optimize its own events.
+       * emitted in emit_occlusion_query_pause(). We note the use of ZPASS_DONE
+       * on the state object, enabling autotuner to optimize its own events.
        */
       if (!cmdbuf->state.pass) {
          tu_cs_emit_pkt7(cs, CP_EVENT_WRITE7, 3);
@@ -1154,6 +1145,33 @@ emit_begin_occlusion_query(struct tu_cmd_buffer *cmdbuf,
    }
 }
 
+template <chip CHIP>
+static void
+emit_begin_occlusion_query(struct tu_cmd_buffer *cmdbuf,
+                           struct tu_query_pool *pool,
+                           uint32_t query)
+{
+   /* From the Vulkan 1.1.130 spec:
+    *
+    *    A query must begin and end inside the same subpass of a render pass
+    *    instance, or must both begin and end outside of a render pass
+    *    instance.
+    *
+    * Unlike on an immediate-mode renderer, Turnip renders all tiles on
+    * vkCmdEndRenderPass, not individually on each vkCmdDraw*. As such, if a
+    * query begins/ends inside the same subpass of a render pass, we need to
+    * record the packets on the secondary draw command stream. cmdbuf->draw_cs
+    * is then run on every tile during render, so we just need to accumulate
+    * sample counts in slot->result to compute the query result.
+    */
+   struct tu_cs *cs = cmdbuf->state.pass ? &cmdbuf->draw_cs : &cmdbuf->cs;
+   cmdbuf->state.occlusion_query_may_be_running = true;
+   cmdbuf->state.dirty |= TU_CMD_DIRTY_DISABLE_FS | TU_CMD_DIRTY_LRZ;
+
+   emit_occlusion_query_resume<CHIP>(cmdbuf, cs,
+                                     occlusion_query_iova(pool, query, begin));
+}
+
 template <chip CHIP>
 static void
 emit_begin_stat_query(struct tu_cmd_buffer *cmdbuf,
@@ -1487,13 +1505,17 @@ tu_CmdBeginQueryIndexedEXT(VkCommandBuffer commandBuffer,
 }
 TU_GENX(tu_CmdBeginQueryIndexedEXT);
 
+/* Pause counting samples into the slot at begin_iova, closing the pair that
+ * emit_occlusion_query_resume() began, and add the samples counted between
+ * them to the slot's result.
+ */
 template <chip CHIP>
 static void
-emit_end_occlusion_query(struct tu_cmd_buffer *cmdbuf,
-                         struct tu_query_pool *pool,
-                         uint32_t query)
+emit_occlusion_query_pause(struct tu_cmd_buffer *cmdbuf,
+                           struct tu_cs *cs,
+                           uint64_t begin_iova)
 {
-   /* Ending an occlusion query happens in a few steps:
+   /* Pausing happens in a few steps:
     *    1) Set the slot->end to UINT64_MAX.
     *    2) Set up the SAMPLE_COUNT registers and trigger a CP_EVENT_WRITE to
     *       write the current sample count value into slot->end.
@@ -1501,19 +1523,9 @@ emit_end_occlusion_query(struct tu_cmd_buffer *cmdbuf,
     *       UINT64_MAX before continuing via CP_WAIT_REG_MEM.
     *    4) Accumulate the results of the query (slot->end - slot->begin) into
     *       slot->result.
-    *    5) If vkCmdEndQuery is *not* called from within the scope of a render
-    *       pass, set the slot's available bit since the query is now done.
-    *    6) If vkCmdEndQuery *is* called from within the scope of a render
-    *       pass, we cannot mark as available yet since the commands in
-    *       draw_cs are not run until vkCmdEndRenderPass.
     */
-   const struct tu_render_pass *pass = cmdbuf->state.pass;
-   struct tu_cs *cs = pass ? &cmdbuf->draw_cs : &cmdbuf->cs;
-
-   uint64_t available_iova = query_available_iova(pool, query);
-   uint64_t begin_iova = occlusion_query_iova(pool, query, begin);
-   uint64_t result_iova = occlusion_query_iova(pool, query, result);
-   uint64_t end_iova = occlusion_query_iova(pool, query, end);
+   uint64_t result_iova = begin_iova + 8;
+   uint64_t end_iova = begin_iova + 16;
 
    if (!cmdbuf->device->physical_device->info->props.has_event_write_sample_count) {
       tu_cs_emit_pkt7(cs, CP_MEM_WRITE, 4);
@@ -1578,6 +1590,25 @@ emit_end_occlusion_query(struct tu_cmd_buffer *cmdbuf,
 
       emit_counter_barrier<CHIP>(cs);
    }
+}
+
+template <chip CHIP>
+static void
+emit_end_occlusion_query(struct tu_cmd_buffer *cmdbuf,
+                         struct tu_query_pool *pool,
+                         uint32_t query)
+{
+   /* If vkCmdEndQuery is *not* called from within the scope of a render pass,
+    * the slot's available bit can be set since the query is now done. If it
+    * *is* called from within the scope of a render pass, we cannot mark it as
+    * available yet since the commands in draw_cs are not run until
+    * vkCmdEndRenderPass.
+    */
+   const struct tu_render_pass *pass = cmdbuf->state.pass;
+   struct tu_cs *cs = pass ? &cmdbuf->draw_cs : &cmdbuf->cs;
+
+   emit_occlusion_query_pause<CHIP>(cmdbuf, cs,
+                                    occlusion_query_iova(pool, query, begin));
 
    if (pass)
       /* Technically, queries should be tracked per-subpass, but here we track
@@ -1589,7 +1620,7 @@ emit_end_occlusion_query(struct tu_cmd_buffer *cmdbuf,
       cs = &cmdbuf->draw_epilogue_cs;
 
    tu_cs_emit_pkt7(cs, CP_MEM_WRITE, 4);
-   tu_cs_emit_qw(cs, available_iova);
+   tu_cs_emit_qw(cs, query_available_iova(pool, query));
    tu_cs_emit_qw(cs, 0x1);
 
    cmdbuf->state.occlusion_query_may_be_running = false;
-- 
