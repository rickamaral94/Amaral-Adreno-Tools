+/* The slot that cmd counts the samples of an occlusion query begun outside of
+ * render passes into, 0 if there is none.
+ */
+static uint64_t
+get_outside_occlusion_query_iova(struct tu_cmd_buffer *cmd)
+{
+   if (cmd->state.outside_occlusion_query_pool) {
+      /* The query cmd began itself. */
+      return occlusion_query_iova(cmd->state.outside_occlusion_query_pool,
+                                  cmd->state.outside_occlusion_query, begin);
+   }
+
+   if (cmd->inherited_occlusion_query) {
+      /* A secondary that may run inside a query begun by the command buffer
+       * executing it counts into a slot of its own, which that command buffer
+       * adds to its count after executing it.
+       */
+      if (!cmd->state.own_occlusion_query_iova) {
+         /* begin, result and end, with begin 16-byte aligned */
+         struct tu_cs_memory memory;
+         tu_cs_set_writeable(&cmd->sub_cs, true);
+         VkResult result = tu_cs_alloc(&cmd->sub_cs, 1, 8, &memory);
+         tu_cs_set_writeable(&cmd->sub_cs, false);
+         if (result != VK_SUCCESS) {
+            vk_command_buffer_set_error(&cmd->vk, result);
+            return 0;
+         }
+         cmd->state.own_occlusion_query_iova = memory.iova;
+      }
+
+      return cmd->state.own_occlusion_query_iova;
+   }
+
+   return 0;
+}
+
+/* An occlusion query begun outside of a render pass is counted when each
+ * render pass it contains is rendered, with a ZPASS_DONE pair around the draws
+ * of each tile, or of the SYSMEM render pass: GMEM rendering can be preempted
+ * between tiles, and the sample count isn't kept across the switch, so no pair
+ * may stay open across tiles. Only draws count samples, and a query contains
+ * whole render passes, so one that is active when a render pass is rendered
+ * contains every suspended and resumed part of it, wherever they were recorded.
+ */
+template <chip CHIP>
+void
+tu_occlusion_query_render_begin(struct tu_cmd_buffer *cmd)
+{
+   /* A secondary command buffer that begins an occlusion query in this render
+    * pass can't be executed while one is active
+    * (VUID-vkCmdExecuteCommands-pCommandBuffers-00105), so nothing would read
+    * its own slot, and the pair counting into it would be around the query's.
+    */
+   if (!cmd->state.outside_occlusion_query_pool &&
+       cmd->state.rp.has_zpass_done_sample_count_write_in_rp)
+      return;
+
+   cmd->state.rendering_occlusion_query_iova =
+      get_outside_occlusion_query_iova(cmd);
+
+   /* The autotuner's ZPASS_DONE events go around ours. */
+   if (cmd->state.rendering_occlusion_query_iova &&
+       cmd->device->physical_device->info->props.has_event_write_sample_count)
+      cmd->state.rp.has_zpass_done_sample_count_write_in_rp = true;
+}
+TU_GENX(tu_occlusion_query_render_begin);
+
+template <chip CHIP>
+void
+tu_occlusion_query_render_end(struct tu_cmd_buffer *cmd)
+{
+   cmd->state.rendering_occlusion_query_iova = 0;
+}
+TU_GENX(tu_occlusion_query_render_end);
+
+template <chip CHIP>
+void
+tu_occlusion_query_draws_begin(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
+{
+   uint64_t iova = cmd->state.rendering_occlusion_query_iova;
+   if (iova)
+      emit_occlusion_query_resume<CHIP>(cmd, cs, iova);
+}
+TU_GENX(tu_occlusion_query_draws_begin);
+
+template <chip CHIP>
+void
+tu_occlusion_query_draws_end(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
+{
+   uint64_t iova = cmd->state.rendering_occlusion_query_iova;
+   if (iova)
+      emit_occlusion_query_pause<CHIP>(cmd, cs, iova);
+}
+TU_GENX(tu_occlusion_query_draws_end);
+
+template <chip CHIP>
+void
+tu_occlusion_query_execute_begin(struct tu_cmd_buffer *cmd,
+                                 struct tu_cmd_buffer *secondary)
+{
+   uint64_t secondary_iova = secondary->state.own_occlusion_query_iova;
+   if (!secondary_iova || !get_outside_occlusion_query_iova(cmd))
+      return;
+
+   /* Every execution of the secondary shares its slot, which is safe because
+    * executions never overlap: even with
+    * VK_COMMAND_BUFFER_USAGE_SIMULTANEOUS_USE_BIT, Turnip has one graphics
+    * queue, and an emulated second queue shares its submit queue.
+    */
+   uint64_t secondary_result_iova = secondary_iova + 8;
+   tu_cs_emit_pkt7(&cmd->cs, CP_MEM_WRITE, 4);
+   tu_cs_emit_qw(&cmd->cs, secondary_result_iova);
+   tu_cs_emit_qw(&cmd->cs, 0);
+}
+TU_GENX(tu_occlusion_query_execute_begin);
+
+template <chip CHIP>
+void
+tu_occlusion_query_execute_end(struct tu_cmd_buffer *cmd,
+                               struct tu_cmd_buffer *secondary)
+{
+   uint64_t secondary_iova = secondary->state.own_occlusion_query_iova;
+   if (!secondary_iova)
+      return;
+
+   uint64_t iova = get_outside_occlusion_query_iova(cmd);
+   if (!iova)
+      return;
+
+   uint64_t result_iova = iova + 8;
+   uint64_t secondary_result_iova = secondary_iova + 8;
+
+   /* result (dst) = result (srcA) + the secondary's result (srcB) */
+   tu_cs_emit_pkt7(&cmd->cs, CP_MEM_TO_MEM, 7);
+   tu_cs_emit(&cmd->cs, CP_MEM_TO_MEM_0_DOUBLE |
+                        CP_MEM_TO_MEM_0_WAIT_FOR_MEM_WRITES);
+   tu_cs_emit_qw(&cmd->cs, result_iova);
+   tu_cs_emit_qw(&cmd->cs, result_iova);
+   tu_cs_emit_qw(&cmd->cs, secondary_result_iova);
+
+   tu_cs_emit_pkt7(&cmd->cs, CP_WAIT_MEM_WRITES, 0);
+}
+TU_GENX(tu_occlusion_query_execute_end);
