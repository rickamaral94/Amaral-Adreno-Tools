+      tu_cs_emit_pkt7(cs, CP_BARRIER, 1);
+      tu_cs_emit(cs, 1);
+   }
+   tu_cs_emit_regs(cs, pack_A6XX_RB_SAMPLE_COUNTER_CNTL(reg));
+}
+
 #endif /* TU_CS_H */
