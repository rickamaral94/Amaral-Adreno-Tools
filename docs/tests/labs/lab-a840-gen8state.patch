Amaral A840 diagnostic lab: gen8 store_3d_blit state fixes (MR !43940 4/7, 5/7, 6/7)

Laboratório, não release. Commits WIP do robclark sem modificação, sobre a 5.7.14.1.
4/7: salva/restaura GRAS_SC_BIN_CNTL separado de RB_CNTL (em gen8 os campos diferem).
5/7: salva/restaura GRAS_LRZ_DEPTH_BUFFER_INFO em store_3d_blit (CHIP >= A7XX).
6/7: CP_BARRIER antes de RB_SAMPLE_COUNTER_CNTL em A8xx.
Atenção: 4/7 e 5/7 também mudam A7xx; distribuir só para teste na A840.

From 099dd4e86184fe68387c52fe29aa860cedf59439 Mon Sep 17 00:00:00 2001
From: Rob Clark <rob.clark@oss.qualcomm.com>
Date: Sat, 22 Aug 2026 08:48:07 -0700
Subject: [PATCH 4/7] WIP: tu: Split GRAS_SC_BIN_CNTL in scratch ram

On gen8, this reg has some different fields from RB_CNTL, so the cute
trick of saving the value once and restoring twice doesn't work.
---
 src/freedreno/vulkan/tu_clear_blit.cc | 3 ++-
 src/freedreno/vulkan/tu_scratch_ram.h | 1 +
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/freedreno/vulkan/tu_clear_blit.cc b/src/freedreno/vulkan/tu_clear_blit.cc
index 722d259e9154..ca7abc68309e 100644
--- a/src/freedreno/vulkan/tu_clear_blit.cc
+++ b/src/freedreno/vulkan/tu_clear_blit.cc
@@ -5742,6 +5742,7 @@ store_3d_blit(struct tu_cmd_buffer *cmd,
     * save/restore them dynamically.
     */
    cs->reg_to_scratch(tu_scratch(store_3d_blit.RB_CNTL), RB_CNTL(CHIP), 1);
+   cs->reg_to_scratch(tu_scratch(store_3d_blit.GRAS_SC_BIN_CNTL), GRAS_SC_BIN_CNTL(CHIP), 1);
 
    if (CHIP >= A7XX) {
       cs->reg_to_scratch(tu_scratch(store_3d_blit.RB_BUFFER_CNTL), RB_BUFFER_CNTL(CHIP), 1);
@@ -5775,7 +5776,7 @@ store_3d_blit(struct tu_cmd_buffer *cmd,
 
    /* Restore RB_CNTL/GRAS_SC_BIN_CNTL saved above. */
    cs->scratch_to_reg(RB_CNTL(CHIP), tu_scratch(store_3d_blit.RB_CNTL), 1);
-   cs->scratch_to_reg(GRAS_SC_BIN_CNTL(CHIP), tu_scratch(store_3d_blit.RB_CNTL), 1);
+   cs->scratch_to_reg(GRAS_SC_BIN_CNTL(CHIP), tu_scratch(store_3d_blit.GRAS_SC_BIN_CNTL), 1);
 
    if (CHIP >= A7XX) {
       cs->scratch_to_reg(RB_BUFFER_CNTL(CHIP), tu_scratch(store_3d_blit.RB_BUFFER_CNTL), 1);
diff --git a/src/freedreno/vulkan/tu_scratch_ram.h b/src/freedreno/vulkan/tu_scratch_ram.h
index 03e14cb4fd52..f989db3c9a72 100644
--- a/src/freedreno/vulkan/tu_scratch_ram.h
+++ b/src/freedreno/vulkan/tu_scratch_ram.h
@@ -18,6 +18,7 @@ union tu_scratch_ram {
     */
    struct {
       uint32_t RB_CNTL;
+      uint32_t GRAS_SC_BIN_CNTL;
       uint32_t RB_BUFFER_CNTL;
    } store_3d_blit;
 
-- 
