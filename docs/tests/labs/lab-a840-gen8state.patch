From e58f1e312f8d69e65497175ac9ddc1251a1800d6 Mon Sep 17 00:00:00 2001
From: Rob Clark <rob.clark@oss.qualcomm.com>
Date: Sat, 22 Aug 2026 10:23:34 -0700
Subject: [PATCH 6/7] WIP: tu: Flush delta counters before
 RB_SAMPLE_COUNTER_CNTL

Fixes the remaining dEQP-VK.pipeline.*.multisample.misc.multi_subpass.*
that were failing in GMEM mode but passing in sysmem.

The load-bearing change is the write in r3d_teardown().  Skipping the
write fixes the tests.  A WFI either before of after the write fixes the
tests.

The only actually occlusion counter use is autotune, but this matters
even with TU_DEBUG=gmem (in which case autotune should not matter).

(The r3d path here is store_3d_blit().. skipping the r3d_teardown() call
in store_3d_blit() with no other changes, *also* fixes the tests, so it
doesn't seem like WFI/CP_BARRIER is papering over some other sync
issue.  Neither cmd->state.predication_active or
cmd->state.prim_generated_query_running_before_rp is true.)
---
 src/freedreno/vulkan/tu_clear_blit.cc |  8 ++++----
 src/freedreno/vulkan/tu_cs.h          | 14 ++++++++++++++
 src/freedreno/vulkan/tu_query_pool.cc |  6 ++----
 3 files changed, 20 insertions(+), 8 deletions(-)

diff --git a/src/freedreno/vulkan/tu_clear_blit.cc b/src/freedreno/vulkan/tu_clear_blit.cc
index 6b083fe19ab3..1f234d7b408d 100644
--- a/src/freedreno/vulkan/tu_clear_blit.cc
+++ b/src/freedreno/vulkan/tu_clear_blit.cc
@@ -1811,7 +1811,7 @@ r3d_setup(struct tu_cmd_buffer *cmd,
       .ccusinglecachelinesize = 2));
 
    /* Disable sample counting in order to not affect occlusion query. */
-   tu_cs_emit_regs(cs, A6XX_RB_SAMPLE_COUNTER_CNTL(.disable = true));
+   tu_write_sample_counter_cntl<CHIP>(cs, {.disable = true});
 
    tu_cs_emit_regs(cs, A6XX_RB_DITHER_CNTL());
    if (CHIP >= A7XX) {
@@ -1871,7 +1871,7 @@ r3d_teardown(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
    }
 
    /* Re-enable sample counting. */
-   tu_cs_emit_regs(cs, A6XX_RB_SAMPLE_COUNTER_CNTL(.disable = false));
+   tu_write_sample_counter_cntl<CHIP>(cs, {.disable = false});
 
    if (cmd->state.prim_generated_query_running_before_rp) {
       tu_emit_event_write<CHIP>(cmd, cs, FD_START_PRIMITIVE_CTRS);
@@ -4405,7 +4405,7 @@ tu_clear_sysmem_attachments(struct tu_cmd_buffer *cmd,
                     cmd->state.subpass->samples);
 
    /* Disable sample counting in order to not affect occlusion query. */
-   tu_cs_emit_regs(cs, A6XX_RB_SAMPLE_COUNTER_CNTL(.disable = true));
+   tu_write_sample_counter_cntl<CHIP>(cs, {.disable = true});
 
    if (cmd->state.prim_generated_query_running_before_rp) {
       tu_emit_event_write<CHIP>(cmd, cs, FD_STOP_PRIMITIVE_CTRS);
@@ -4530,7 +4530,7 @@ tu_clear_sysmem_attachments(struct tu_cmd_buffer *cmd,
    }
 
    /* Re-enable sample counting. */
-   tu_cs_emit_regs(cs, A6XX_RB_SAMPLE_COUNTER_CNTL(.disable = false));
+   tu_write_sample_counter_cntl<CHIP>(cs, {.disable = false});
 
    if (cmd->state.prim_generated_query_running_before_rp) {
       tu_emit_event_write<CHIP>(cmd, cs, FD_START_PRIMITIVE_CTRS);
diff --git a/src/freedreno/vulkan/tu_cs.h b/src/freedreno/vulkan/tu_cs.h
index 0a94086e6432..e173ff83e244 100644
--- a/src/freedreno/vulkan/tu_cs.h
+++ b/src/freedreno/vulkan/tu_cs.h
@@ -1094,4 +1094,18 @@ tu_scratch_reg(int idx, uint32_t val = 0)
    }
 }
 
+template <chip CHIP>
+static inline void
+tu_write_sample_counter_cntl(struct tu_cs *cs, struct A6XX_RB_SAMPLE_COUNTER_CNTL reg = {})
+{
+   if (CHIP >= A8XX) {
+      // TODO possibly we can skip this when enabling sample counts (where we don't care
+      // about previous state?)
