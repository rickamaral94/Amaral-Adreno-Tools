+From 29db4909d4e808627c8d43767a36476034321a14 Mon Sep 17 00:00:00 2001
+From: Danylo Piliaiev <dpiliaiev@igalia.com>
+Date: Thu, 22 Oct 2026 16:20:11 +0200
+Subject: [PATCH] ir3/ra: fix DOUBLE_ONLY register limit unit
+
+RA counts register pressure in half-register units. One full vec4
+is 8 units (`RA_HALF_VEC4_SIZE * 2`). `ir3_ra_get_reg_file_limits`
+for the DOUBLE_ONLY limit erroneously used 16 units per vec4.
+
+All GPUs with reg_size_vec4 < 96 are affected: a6xx gen1_low,
+gen3 and gen4. A630 and A7xx are not affected.
+
+Also, name related magic numbers along the way.
+
+Closes: https://gitlab.freedesktop.org/mesa/mesa/-/work_items/16214
+Assisted-by: LLM
+Signed-off-by: Danylo Piliaiev <dpiliaiev@igalia.com>
+Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45517>
+---
+ src/freedreno/ir3/ir3_ra.c | 7 ++++---
+ src/freedreno/ir3/ir3_ra.h | 6 ++++--
+ 2 files changed, 8 insertions(+), 5 deletions(-)
+
+diff --git a/src/freedreno/ir3/ir3_ra.c b/src/freedreno/ir3/ir3_ra.c
+index 34e4bc4cbee..02706b073a2 100644
+--- a/src/freedreno/ir3/ir3_ra.c
++++ b/src/freedreno/ir3/ir3_ra.c
+@@ -2751,7 +2751,7 @@ calc_cs_barrier_reg_budget(struct ir3_shader_variant *v,
+       (wave_pairs_per_wg * (double_threadsize ? 2 : 1));
+    assert(vec4_regs_per_thread > 0);
+ 
+-   return vec4_regs_per_thread * 4 * 2;
++   return vec4_regs_per_thread * RA_FULL_VEC4_SIZE;
+ }
+ 
+ struct ir3_pressure
+@@ -2776,7 +2776,8 @@ ir3_ra_get_reg_file_limits(struct ir3_shader_variant *v)
+     */
+    if (v->shader_options.real_wavesize == IR3_DOUBLE_ONLY) {
+       limit_pressure.full =
+-         MIN2(limit_pressure.full, v->compiler->reg_size_vec4 / 2 * 16);
++         MIN2(limit_pressure.full,
++              v->compiler->reg_size_vec4 / 2 * RA_FULL_VEC4_SIZE);
+    }
+ 
+    assert(limit_pressure.full <= RA_FULL_SIZE);
+@@ -2848,7 +2849,7 @@ ir3_ra(struct ir3_shader_variant *v)
+    }
+ 
+    /* Both banks come out of one file, in half-units. */
+-   unsigned phys_file_size = v->compiler->reg_size_vec4 * 4 * 2;
++   unsigned phys_file_size = v->compiler->reg_size_vec4 * RA_FULL_VEC4_SIZE;
+ 
+    if (!v->mergedregs && mesa_shader_stage_is_compute(v->type) &&
+        v->shader->nir->info.uses_control_barrier)
+diff --git a/src/freedreno/ir3/ir3_ra.h b/src/freedreno/ir3/ir3_ra.h
+index 558b81c82c2..d55af1e799b 100644
+--- a/src/freedreno/ir3/ir3_ra.h
++++ b/src/freedreno/ir3/ir3_ra.h
+@@ -122,8 +122,10 @@ ra_reg_is_predicate(const struct ir3_register *reg)
+ #define ra_foreach_dst(__dstreg, __instr)                                      \
+    ra_foreach_dst_n(__dstreg, __i, __instr)
+ 
+-#define RA_HALF_SIZE     (4 * 48)
+-#define RA_FULL_SIZE     (4 * 48 * 2)
++#define RA_HALF_VEC4_SIZE 4
++#define RA_FULL_VEC4_SIZE (RA_HALF_VEC4_SIZE * 2)
++#define RA_HALF_SIZE     (RA_HALF_VEC4_SIZE * 48)
++#define RA_FULL_SIZE     (RA_FULL_VEC4_SIZE * 48)
+ #define RA_SHARED_SIZE   (2 * 4 * 8)
+ #define RA_SHARED_HALF_SIZE (4 * 8)
+ #define RA_MAX_FILE_SIZE RA_FULL_SIZE
+-- 
+2.43.0
+
